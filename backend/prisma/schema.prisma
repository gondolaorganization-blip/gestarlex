// GESTARLEX — Schema Prisma
// Gestión de firmas de abogados en Panamá
// Marco legal: Ley 402 de 2023, Acuerdo 49 de 2001 del Órgano Judicial

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum PlanFirma {
  SOLO       // 1 abogado, 50 casos — B/.39.99/mes (intro)
  FIRMA      // 5 abogados, ilimitado — B/.99/mes (intro)
  ENTERPRISE // ilimitado, multi-oficina — B/.199/mes (intro)
}

enum RolAbogado {
  SOCIO
  ASOCIADO
  PASANTE
  ADMIN      // administrador del sistema, sin rol jurídico
}

enum TipoCliente {
  PERSONA_NATURAL
  JURIDICA
}

enum TipoCaso {
  CIVIL
  PENAL
  LABORAL
  COMERCIAL
  ADMINISTRATIVO
  FAMILIAR
  MARITIMO   // Tribunal Marítimo de Panamá
  OTRO
}

enum EstadoCaso {
  ACTIVO
  SUSPENDIDO
  CERRADO
  ARCHIVADO
}

enum EstadoAudiencia {
  PENDIENTE
  REALIZADA
  SUSPENDIDA
  CANCELADA
}

enum EstadoTermino {
  PENDIENTE
  COMPLETADO
  VENCIDO
}

enum PrioridadTermino {
  ALTA
  MEDIA
  BAJA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

enum PrioridadTarea {
  ALTA
  MEDIA
  BAJA
}

enum TipoHonorario {
  HORA         // por hora trabajada — ref. Acuerdo 49/2001
  FIJO         // monto fijo por caso
  CONTINGENCIA // porcentaje del éxito
  MIXTO        // combinación
}

enum EstadoFactura {
  BORRADOR
  ENVIADA
  PAGADA
  VENCIDA
  ANULADA
}

enum TipoPoder {
  GENERAL    // poder general — Código Civil de Panamá
  ESPECIAL   // poder especial para acto determinado
  JUDICIAL   // poder especial para representación judicial
}

enum EstadoTimer {
  CORRIENDO
  PAUSADO
}

enum EstadoSuscripcion {
  TRIAL
  ACTIVO
  SUSPENDIDO
  VENCIDO
}

enum TipoComunicacion {
  EMAIL
  LLAMADA
  REUNION
  WHATSAPP
  CARTA
}

// ─── SYNC GOOGLE CALENDAR ─────────────────────────────────────────────────────

enum EstadoGoogleCuenta {
  ACTIVA
  REVOCADA   // el usuario retiró el permiso desde su cuenta de Google
  ERROR      // el refresh token dejó de funcionar; requiere reconectar
}

// Qué entidad de GestarLex representa un evento sincronizado.
// EXTERNO = nació en Google y todavía no está atado a un caso.
enum TipoEventoSync {
  AUDIENCIA
  TERMINO
  TAREA
  EXTERNO
}

enum EstadoCalendarLink {
  OK
  CONFLICTO         // cambió en ambos lados: congelado hasta que el usuario decida
  PENDIENTE_BORRADO // desapareció de un lado: nunca se borra sin confirmación
}

enum TipoIncidenciaSync {
  CONFLICTO
  BORRADO_EN_GOOGLE
  BORRADO_EN_GESTARLEX
  ERROR
}

enum EstadoIncidenciaSync {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum TipoGasto {
  TASA_JUDICIAL  // tasas y timbres judiciales panameños
  NOTARIA        // gastos notariales
  TRANSPORTE
  REGISTRO       // Registro Público de Panamá
  OTRO
}

// ─── MODELOS ──────────────────────────────────────────────────────────────────

// Refresh tokens almacenados en DB para invalidación segura
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  abogadoId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  abogado Abogado @relation(fields: [abogadoId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Firma {
  id                   String             @id @default(cuid())
  nombre               String
  ruc                  String             @unique
  direccion            String?
  telefono             String?
  email                String             @unique
  logo                 String?
  especialidades       String[]
  plan                 PlanFirma          @default(SOLO)
  activa               Boolean            @default(true)
  // ── Suscripción ──────────────────────────────────────────────────────────
  suscripcionEstado    EstadoSuscripcion  @default(TRIAL)
  trialEndsAt          DateTime?          // null = sin período de prueba activo
  suscripcionVenceEn   DateTime?          // fin del período de pago actual
  accessManual         Boolean            @default(false) // acceso otorgado manualmente por super admin
  paypalSubscriptionId String?            @unique
  // ── Uso IA ───────────────────────────────────────────────────────────────
  aiConsultasMes       Int                @default(0)
  aiConsultasResetEn   DateTime?          // cuándo se resetea el contador (primer día del mes)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  abogados            Abogado[]
  clientes            Cliente[]
  casos               Caso[]
  facturas            Factura[]
  suscripcionEventos  SuscripcionEvento[]
  emailLogs           EmailLog[]
  apiKeys             ApiKey[]
  googleCuenta        GoogleCuenta?
  eventosExternos     EventoExterno[]

  @@map("firmas")
}

// Abogado — usuario del sistema con número de idoneidad de la CSJ
model Abogado {
  id              String     @id @default(cuid())
  firmaId         String
  nombre          String
  numeroIdoneidad String     @unique // otorgado por la Corte Suprema de Justicia
  especialidad    String?
  email           String     @unique
  telefono        String?
  rol             RolAbogado @default(ASOCIADO)
  activo          Boolean    @default(true)
  passwordHash    String?
  avatarUrl       String?
  notasTareas     String?    // bloc de notas personal de la bandeja de tareas
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  firma             Firma           @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  casosResponsable  Caso[]          @relation("AbogadoPrincipal")
  casosAsignados    CasoAbogado[]
  tareas            Tarea[]
  registrosHoras    RegistroHoras[]
  comunicaciones    Comunicacion[]
  documentosSubidos Documento[]
  refreshTokens     RefreshToken[]
  timers            Timer[]
  apiKeys           ApiKey[]

  @@map("abogados")
}

// Cliente — persona natural o jurídica representada por la firma
model Cliente {
  id        String      @id @default(cuid())
  firmaId   String
  nombre    String
  cedula    String?     // cédula de identidad (persona natural)
  ruc       String?     // Registro Único de Contribuyente (persona jurídica)
  email     String?
  telefono  String?
  tipo      TipoCliente @default(PERSONA_NATURAL)
  origen    String?     // referido, web, llamada, etc.
  activo    Boolean     @default(true)
  notas     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  firma          Firma          @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  casos          Caso[]         @relation("ClientePrincipal")
  casosAdicionales CasoCliente[]
  poderes        Poder[]
  comunicaciones Comunicacion[]
  facturas       Factura[]

  @@map("clientes")
}

// Caso — expediente judicial o consultoría
model Caso {
  id            String     @id @default(cuid())
  firmaId       String
  clienteId     String
  abogadoId     String     // abogado responsable principal
  numero        String     // número de expediente judicial (SNEL)
  titulo        String
  tipo          TipoCaso   @default(CIVIL)
  juzgado       String?    // juzgado panameño asignado
  juez          String?
  contraparte   String?
  estado        EstadoCaso @default(ACTIVO)
  fechaApertura DateTime   @default(now())
  fechaCierre   DateTime?
  descripcion   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  firma               Firma            @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  cliente             Cliente          @relation("ClientePrincipal", fields: [clienteId], references: [id])
  clientesAdicionales CasoCliente[]
  abogado             Abogado          @relation("AbogadoPrincipal", fields: [abogadoId], references: [id])
  abogados            CasoAbogado[]
  audiencias      Audiencia[]
  terminos        TerminoProcesal[]
  documentos      Documento[]
  tareas          Tarea[]
  honorarioConfig HonorarioConfig?
  registrosHoras  RegistroHoras[]
  facturas        Factura[]
  poderes         Poder[]
  comunicaciones  Comunicacion[]
  gastos          Gasto[]
  historial       CasoHistorial[]
  timers          Timer[]
  emailLogs       EmailLog[]
  eventosExternos EventoExterno[]

  @@unique([firmaId, numero])
  @@map("casos")
}

// Tabla intermedia — múltiples clientes por caso (co-demandantes, co-demandados, garantes)
model CasoCliente {
  id        String   @id @default(cuid())
  casoId    String
  clienteId String
  rol       String?  // "co-demandante", "co-demandado", "garante", etc.
  createdAt DateTime @default(now())

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([casoId, clienteId])
  @@map("casos_clientes")
}

// Tabla intermedia — múltiples abogados por caso (co-defensores, equipo)
model CasoAbogado {
  id        String   @id @default(cuid())
  casoId    String
  abogadoId String
  rol       String?  // "co-defensor", "apoyo", "supervisión"
  createdAt DateTime @default(now())

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  abogado Abogado @relation(fields: [abogadoId], references: [id])

  @@unique([casoId, abogadoId])
  @@map("casos_abogados")
}

// Historial de cambios de estado del caso
model CasoHistorial {
  id            String      @id @default(cuid())
  casoId        String
  estadoAntes   EstadoCaso?
  estadoDespues EstadoCaso
  nota          String?
  fecha         DateTime    @default(now())
  abogadoId     String?     // quien realizó el cambio

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@map("casos_historial")
}

// Audiencia — actos procesales orales (Ley 402 de 2023)
model Audiencia {
  id        String          @id @default(cuid())
  casoId    String
  titulo    String
  fecha     DateTime
  hora      String?         // "09:00" — hora de la audiencia
  juzgado   String?
  sala      String?         // sala del juzgado
  tipo      String?         // "inicial", "pruebas", "alegatos", "sentencia", "conciliación"
  resultado String?
  notas     String?
  estado    EstadoAudiencia @default(PENDIENTE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@map("audiencias")
}

// Término Procesal — plazos según Ley 402 de 2023 y CPC panameño
model TerminoProcesal {
  id           String           @id @default(cuid())
  casoId       String
  descripcion  String
  fechaVence   DateTime
  diasAlerta   Int              @default(3) // alertar N días antes
  estado       EstadoTermino    @default(PENDIENTE)
  prioridad    PrioridadTermino @default(MEDIA)
  completadoEn DateTime?
  notas        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@map("terminos_procesales")
}

// Documento — archivos del expediente
model Documento {
  id           String   @id @default(cuid())
  casoId       String
  nombre       String
  tipo         String?  // "demanda", "contestación", "resolución", "sentencia", "poder", "otro"
  archivo      String   // path o URL del archivo
  mimeType     String?
  tamanoBytes  Int?
  version      Int      @default(1)
  fechaSubida  DateTime @default(now())
  subidoPorId  String?
  confidencial Boolean  @default(false)
  descripcion  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  caso      Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  subidoPor Abogado? @relation(fields: [subidoPorId], references: [id])

  @@map("documentos")
}

// Tarea — trabajo pendiente asignado a un abogado
model Tarea {
  id           String         @id @default(cuid())
  casoId       String
  abogadoId    String
  descripcion  String
  fechaLimite  DateTime?
  estado       EstadoTarea    @default(PENDIENTE)
  prioridad    PrioridadTarea @default(MEDIA)
  completadaEn DateTime?
  notas        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  abogado Abogado @relation(fields: [abogadoId], references: [id])

  @@map("tareas")
}

// Configuración de honorarios — ref. Acuerdo 49 de 2001 del Órgano Judicial
model HonorarioConfig {
  id               String        @id @default(cuid())
  casoId           String        @unique
  tipo             TipoHonorario @default(HORA)
  tarifaHora       Decimal?      @db.Decimal(10, 2)
  montoFijo        Decimal?      @db.Decimal(10, 2)
  porcentajeExito  Decimal?      @db.Decimal(5, 2) // ej: 15.00 = 15%
  descripcion      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@map("honorarios_config")
}

// Registro de horas — control de tiempo facturable por abogado
model RegistroHoras {
  id          String   @id @default(cuid())
  casoId      String
  abogadoId   String
  fecha       DateTime @default(now())
  horas       Decimal  @db.Decimal(5, 2) // ej: 1.5 horas
  descripcion String
  facturable  Boolean  @default(true)
  facturaId   String?  // referencia si ya fue facturado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  abogado Abogado @relation(fields: [abogadoId], references: [id])

  @@map("registros_horas")
}

// Factura — cobro de honorarios al cliente
model Factura {
  id        String        @id @default(cuid())
  firmaId   String
  clienteId String
  casoId    String?
  numero    String        // número correlativo de factura
  monto     Decimal       @db.Decimal(10, 2)
  estado    EstadoFactura @default(BORRADOR)
  fecha     DateTime      @default(now())
  vence     DateTime?
  notas     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  destinatariosAdicionales Json?     // [{nombre, documento, tipoDoc}] — co-destinatarios opcionales

  firma   Firma   @relation(fields: [firmaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  caso    Caso?   @relation(fields: [casoId], references: [id])

  @@unique([firmaId, numero])
  @@map("facturas")
}

// Poder — poder general o especial según Código Civil de Panamá
// Datos notariales: notaría, tomo y folio del Registro Público
model Poder {
  id               String    @id @default(cuid())
  clienteId        String
  casoId           String?
  tipo             TipoPoder @default(ESPECIAL)
  fechaOtorgamiento DateTime
  fechaVence       DateTime? // null = indefinido
  notaria          String?   // nombre de la notaría panameña
  tomo             String?   // tomo del Registro Público
  folio            String?   // folio del Registro Público
  activo           Boolean   @default(true)
  descripcion      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])
  caso    Caso?   @relation(fields: [casoId], references: [id])

  @@map("poderes")
}

// Comunicación — registro de todas las interacciones con el cliente
model Comunicacion {
  id          String           @id @default(cuid())
  casoId      String?
  clienteId   String
  abogadoId   String
  tipo        TipoComunicacion @default(EMAIL)
  descripcion String
  fecha       DateTime         @default(now())
  notas       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  caso    Caso?   @relation(fields: [casoId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  abogado Abogado @relation(fields: [abogadoId], references: [id])

  @@map("comunicaciones")
}

// Timer — cronómetro por caso, persistente entre reinicios del servidor
model Timer {
  id                  String      @id @default(cuid())
  casoId              String
  abogadoId           String
  descripcion         String?
  iniciadoEn          DateTime    @default(now())
  pausadoEn           DateTime?
  duracionAcumulada   Int         @default(0) // segundos acumulados en pausas previas
  estado              EstadoTimer @default(CORRIENDO)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  abogado Abogado @relation(fields: [abogadoId], references: [id])

  @@unique([casoId, abogadoId]) // un timer activo por caso+abogado
  @@map("timers")
}

// SuperAdmin — administrador global del SaaS (separado de los abogados/firmas)
model SuperAdmin {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// SuscripcionEvento — log de cambios de estado de suscripción por firma
model SuscripcionEvento {
  id        String   @id @default(cuid())
  firmaId   String
  evento    String   // "TRIAL_INICIADO", "PAGO_RECIBIDO", "ACCESO_MANUAL", "SUSPENDIDA", "REACTIVADA"
  detalle   Json?    // datos adicionales del webhook o acción manual
  creadoPor String?  // "paypal_webhook" | "super_admin:<id>" | "sistema"
  createdAt DateTime @default(now())

  firma Firma @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@map("suscripcion_eventos")
}

// Gasto — costos del caso (tasas judiciales, notariales, etc.)
model Gasto {
  id           String    @id @default(cuid())
  casoId       String
  descripcion  String
  monto        Decimal   @db.Decimal(10, 2)
  tipo         TipoGasto @default(OTRO)
  fecha        DateTime  @default(now())
  reembolsable Boolean   @default(false)
  reembolsado  Boolean   @default(false)
  comprobante  String?   // path de imagen o PDF del comprobante
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@map("gastos")
}

// Registro de emails automáticos enviados por el sistema
model EmailLog {
  id           String    @id @default(cuid())
  firmaId      String
  casoId       String?
  tipo         String    // TAREA_COMPLETADA | NUEVA_AUDIENCIA | NUEVO_TERMINO | FACTURA_ENVIADA | RECORDATORIO_AUDIENCIA | ALERTA_TERMINO
  asunto       String
  destinatario String
  enviado      Boolean   @default(false)
  fechaEnvio   DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  firma  Firma  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  caso   Caso?  @relation(fields: [casoId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

// ApiKey — credencial para automatizaciones externas (no reemplaza el login del abogado).
// Solo otorga lectura y actualización; el router de integraciones no expone borrado.
model ApiKey {
  id          String    @id @default(cuid())
  firmaId     String
  abogadoId   String    // a quién se le atribuyen las escrituras hechas con esta key
  nombre      String    // "laptop", "celular", etc. — para saber cuál revocar
  prefijo     String    // primeros caracteres visibles, para identificarla sin exponerla
  hash        String    @unique // SHA-256 de la key completa; el valor en claro no se guarda
  scopes      String[]  @default(["casos:read"]) // casos:read | casos:write — nunca borrado
  activa      Boolean   @default(true)
  ultimoUsoEn DateTime?
  expiraEn    DateTime?
  revocadaEn  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  firma   Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  abogado Abogado @relation(fields: [abogadoId], references: [id], onDelete: Cascade)

  @@index([firmaId])
  @@map("api_keys")
}

// ─── GOOGLE CALENDAR ──────────────────────────────────────────────────────────

// GoogleCuenta — la conexión OAuth del despacho con Google Calendar.
// Una por firma: los eventos de todos los abogados van al mismo calendario secundario.
//
// SALVAGUARDA #1 — calendarId se fija UNA sola vez, en el callback de OAuth, tras
// verificar que el calendario se llama "GestarLex" y que NO es el principal. Ninguna
// ruta acepta un calendarId por request: el wrapper de Google siempre lo lee de acá.
model GoogleCuenta {
  id                  String             @id @default(cuid())
  firmaId             String             @unique
  abogadoId           String             // quién autorizó la conexión
  googleEmail         String             // cuenta de Google conectada, para mostrar en la UI
  calendarId          String             // ID del calendario secundario "GestarLex"
  calendarSummary     String             // nombre tal como lo devolvió Google, para verificarlo
  // Tokens cifrados con AES-256-GCM (ver lib/cifrado.js). Nunca en texto plano,
  // nunca en logs, nunca en una respuesta de la API.
  refreshTokenCifrado String
  accessTokenCifrado  String?
  accessTokenExpiraEn DateTime?
  scopes              String[]
  // syncToken de Google: permite pedir SOLO lo que cambió desde la última corrida.
  // Si Google lo invalida (410), se hace una resincronización completa.
  syncToken           String?
  estado              EstadoGoogleCuenta @default(ACTIVA)
  // Interruptor del sync masivo. Arranca APAGADO a propósito: hasta que la prueba
  // de un solo evento pase en ambas direcciones, el backfill no puede correr —
  // ni por cron ni por endpoint. Se enciende explícitamente desde la UI.
  syncCompletoHabilitado Boolean         @default(false)
  ultimoSyncEn        DateTime?
  ultimoErrorEn       DateTime?
  ultimoError         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  firma        Firma           @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  links        CalendarLink[]
  incidencias  SyncIncidencia[]

  @@map("google_cuentas")
}

// CalendarLink — el mapeo entre un registro de GestarLex y un evento de Google.
//
// SALVAGUARDA #2 (idempotencia) — los dos @@unique son el candado principal: si ya
// existe la fila, el sync hace UPDATE, jamás INSERT. El candado secundario vive en el
// propio ID del evento en Google, que es determinístico (derivado del cuid local), de
// modo que aun perdiendo esta tabla un re-alta devuelve 409 en vez de crear un duplicado.
model CalendarLink {
  id             String             @id @default(cuid())
  cuentaId       String
  tipoLocal      TipoEventoSync
  localId        String             // id del Audiencia/TerminoProcesal/Tarea/EventoExterno
  googleEventId  String
  // hashLocal — huella de los campos sincronizados en la última corrida exitosa.
  // Si no cambió, ni siquiera se llama a Google. Comparado contra el etag de Google,
  // es lo que permite detectar un conflicto en vez de pisar (salvaguarda #4).
  hashLocal      String?
  etagGoogle     String?
  updatedGoogle  DateTime?
  estado         EstadoCalendarLink @default(OK)
  ultimoSyncEn   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  cuenta      GoogleCuenta     @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  incidencias SyncIncidencia[]

  @@unique([cuentaId, tipoLocal, localId])
  @@unique([cuentaId, googleEventId])
  @@index([cuentaId, estado])
  @@map("calendar_links")
}

// SyncIncidencia — todo lo que el sync NO resuelve solo y requiere decisión humana.
//
// SALVAGUARDAS #3 y #4 — ningún borrado ni ninguna sobreescritura en conflicto ocurre
// de forma automática: se crea una incidencia PENDIENTE con ambas versiones guardadas,
// y la acción real solo se ejecuta cuando el usuario la resuelve explícitamente.
model SyncIncidencia {
  id            String               @id @default(cuid())
  cuentaId      String
  linkId        String?              // null si el link ya no existe
  tipo          TipoIncidenciaSync
  titulo        String               // resumen legible para la bandeja de la UI
  versionLocal  Json?                // snapshot del registro de GestarLex
  versionGoogle Json?                // snapshot del evento de Google
  detalle       String?
  estado        EstadoIncidenciaSync @default(PENDIENTE)
  resolucion    String?              // qué eligió el usuario: GESTARLEX | GOOGLE | IGNORAR | BORRAR
  resueltaEn    DateTime?
  resueltaPorId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  cuenta GoogleCuenta  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  link   CalendarLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([cuentaId, estado])
  @@map("sync_incidencias")
}

// EventoExterno — evento creado directamente en el calendario "GestarLex" de Google.
// Audiencia, TerminoProcesal y Tarea exigen casoId, y un evento nacido en Google no
// trae caso: en vez de inventarle uno, aterriza acá y se muestra en el calendario como
// "externo, sin caso" hasta que el usuario lo asigne o lo convierta.
model EventoExterno {
  id            String    @id @default(cuid())
  firmaId       String
  titulo        String
  inicio        DateTime
  fin           DateTime?
  todoElDia     Boolean   @default(false)
  descripcion   String?
  ubicacion     String?
  casoId        String?   // asignado a mano después, desde la UI
  convertidoAId String?   // id de la Audiencia/Termino/Tarea si se convirtió
  convertidoA   TipoEventoSync?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  firma Firma @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  caso  Caso? @relation(fields: [casoId], references: [id], onDelete: SetNull)

  @@index([firmaId, inicio])
  @@map("eventos_externos")
}
